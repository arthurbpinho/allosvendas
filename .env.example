# Copie para .env e preencha. O .env nunca vai para o git.

# Obrigatórias
JWT_SECRET=gere-com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_INITIAL_PASSWORD=senha-forte-do-gestor-12-ou-mais

# IA (sem a chave, o app roda em modo demonstração com respostas fixas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Esforço de raciocínio por etapa (igual ao all_OS). Vazio ("") omite o parâmetro.
SIMULADOR_EFFORT=high
AVALIADOR_EFFORT=high
SINTETIZADOR_EFFORT=medium

# Produção (Railway): volume persistente montado em /data
# DATA_DIR=/data
